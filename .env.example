# OpenAI-compatible Chat Completions. Base excludes /chat/completions.
# DeepSeek below is an example; replace base/model/allowed models for another provider.
# Server-side only. Never put a real key in this tracked example.
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_ALLOWED_MODELS=deepseek-chat,deepseek-reasoner,deepseek-flash
# Blocking connection/read wait, not a hard total job deadline.
LLM_TIMEOUT=60
# Retries for eligible HTTP/network failures; timeouts are not replayed.
LLM_MAX_RETRIES=1
# Full message character budget; one indivisible review block may exceed it.
LLM_MAX_BATCH_CHARS=12000
# Bounded parallel batches; disable automatic second-pass correction for faster review.
LLM_MAX_CONCURRENCY=2
LLM_AUTO_CORRECT=false
# Optional provider/model-specific reasoning_effort; blank omits the request field.
# For example low/medium/high, only when supported by the chosen API/model.
LLM_REASONING_EFFORT=

# Optional PDF layout preview. Leave the path empty to auto-detect soffice/libreoffice.
LIBREOFFICE_PATH=
PDF_PREVIEW_TIMEOUT=45

# Shared Web state and privacy-minimal aggregate statistics.
# Set explicit absolute paths for Gunicorn multi-worker deployment.
WEEKLY_REPORT_SNAPSHOT_DIR=
# Review session lifetime: hours (h), days (d), weeks (w), e.g. 24h / 3d / 1w.
# Chinese units 小时 / 天 / 周 are also supported. Blank uses 2h.
# Restart both Web and Worker; existing sessions retain their saved expiry.
REPORT_SESSION_TTL=2h
# Empty uses <project>/var/stats.sqlite3; explicit absolute paths override it.
STATS_DB_PATH=
REPORT_TIMEZONE=Asia/Shanghai
# Optional: use a stable random value of at least 16 bytes across all workers.
STATS_HMAC_KEY=

# Persistent background tasks. Web and independent Worker must share these values.
# Blank paths use <project>/var/tasks.sqlite3 and <project>/var/tasks.
TASK_DB_PATH=
TASK_FILES_DIR=
TASK_MAX_CONCURRENCY=2
TASK_QUEUE_CAPACITY=100

# Permanent shared report profiles. Blank uses <project>/var/profiles.
# The metadata database is the sibling <directory-name>.sqlite3. No automatic expiry.
REPORT_PROFILES_DIR=
